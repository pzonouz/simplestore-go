{
  "index_patterns": ["products"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "max_ngram_diff": 10
      },
      "analysis": {
        "tokenizer": {
          "my_ngram_tokenizer": {
            "type": "ngram",
            "min_gram": 3,
            "max_gram": 10,
            "token_chars": ["letter", "digit"]
          }
        },
        "analyzer": {
          "my_ngram_analyzer": {
            "type": "custom",
            "tokenizer": "my_ngram_tokenizer",
            "filter": ["lowercase"]
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "id": { "type": "keyword" },
        "name": {
          "type": "text",
          "fields": {
            "ngrams": {
              "type": "text",
              "analyzer": "my_ngram_analyzer",
              "search_analyzer": "standard"
            },
            "keyword": { "type": "keyword" }
          }
        },
        "price": { "type": "long" },
        "image_url": { "type": "keyword" },
        "slug": { "type": "keyword" }
      }
    }
  }
}
